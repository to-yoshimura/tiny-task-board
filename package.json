{
  "name": "tiny-task-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bdd": "cucumber-js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "verify": "npm run typecheck && npm test && npm run test:bdd && npm run build"
  },
  "dependencies": {
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
