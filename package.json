    "start": "node dist/src/server.js",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
